{
  "name": "@screenshotapinet/mcp",
  "version": "1.0.0",
  "description": "Official MCP server for ScreenshotAPI — website screenshots, URL/HTML to PDF, scrolling videos, web scraping (text, Markdown, HTML), and bulk captures as MCP tools for Claude, Cursor, Windsurf, and any MCP client.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "screenshot",
    "website-screenshot",
    "url-to-pdf",
    "html-to-pdf",
    "web-scraping",
    "screenshotapi",
    "claude",
    "ai-tools"
  ],
  "homepage": "https://www.screenshotapi.net",
  "bugs": "https://github.com/ScreenshotAPInet/screenshotapi-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScreenshotAPInet/screenshotapi-mcp.git"
  },
  "license": "MIT",
  "author": "ScreenshotAPI",
  "type": "module",
  "bin": {
    "screenshotapi-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepublishOnly": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
